// Data Laporan
$dari = isset($_GET['dari']) ? $_GET['dari'] : date('Y-m-01');
$sampai = isset($_GET['sampai']) ? $_GET['sampai'] : date('Y-m-d');

$query_total_transaksi = "SELECT COUNT(*) as total FROM tb_transaksi WHERE DATE(tanggal) BETWEEN '$dari' AND '$sampai'";
$result_total = mysqli_query($conn, $query_total_transaksi);
$total_transaksi = mysqli_fetch_assoc($result_total)['total'];

$query_total_penjualan = "SELECT SUM(total_harga) as total FROM tb_transaksi WHERE DATE(tanggal) BETWEEN '$dari' AND '$sampai'";
$result_penjualan = mysqli_query($conn, $query_total_penjualan);
$total_penjualan = mysqli_fetch_assoc($result_penjualan)['total'] ?? 0;

$query_total_hpp = "
    SELECT SUM(dt.jumlah_beli * m.hpp) as total_hpp 
    FROM tb_detail_transaksi dt 
    JOIN tb_transaksi t ON dt.id_transaksi = t.id_transaksi 
    JOIN tb_menu m ON dt.id_menu = m.id_menu 
    WHERE DATE(t.tanggal) BETWEEN '$dari' AND '$sampai'
";
$result_hpp = mysqli_query($conn, $query_total_hpp);
$total_hpp = mysqli_fetch_assoc($result_hpp)['total_hpp'] ?? 0;

// Hitung pengeluaran dalam periode laporan
$query_pengeluaran_periode = "SELECT SUM(ABS(jumlah)) as total FROM tb_modal WHERE jenis = 'pengeluaran' AND tanggal BETWEEN '$dari' AND '$sampai'";
$result_pengeluaran_periode = mysqli_query($conn, $query_pengeluaran_periode);
$total_pengeluaran_periode = mysqli_fetch_assoc($result_pengeluaran_periode)['total'] ?? 0;

$total_keuntungan = $total_penjualan - $total_hpp - $total_pengeluaran_periode;

$query_terlaris = "
    SELECT m.nama_menu, SUM(dt.jumlah_beli) as total_qty, SUM(dt.total) as total_penjualan
    FROM tb_detail_transaksi dt
    JOIN tb_menu m ON dt.id_menu = m.id_menu
    JOIN tb_transaksi t ON dt.id_transaksi = t.id_transaksi
    WHERE DATE(t.tanggal) BETWEEN '$dari' AND '$sampai'
    GROUP BY dt.id_menu
    ORDER BY total_qty DESC
    LIMIT 5
";
$result_terlaris = mysqli_query($conn, $query_terlaris);

$query_riwayat = "
    SELECT t.*, 
           COUNT(dt.id_detail) as jumlah_item,
           SUM(dt.jumlah_beli * m.hpp) as hpp_transaksi
    FROM tb_transaksi t
    LEFT JOIN tb_detail_transaksi dt ON t.id_transaksi = dt.id_transaksi
    LEFT JOIN tb_menu m ON dt.id_menu = m.id_menu
    WHERE DATE(t.tanggal) BETWEEN '$dari' AND '$sampai'
    GROUP BY t.id_transaksi
    ORDER BY t.tanggal DESC
";
$result_riwayat = mysqli_query($conn, $query_riwayat);
