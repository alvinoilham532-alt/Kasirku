if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['tambah_keranjang'])) {
    $id_menu = (int)$_POST['id_menu'];
    $qty = (int)$_POST['qty'];
    
    $query = "SELECT * FROM tb_menu WHERE id_menu = $id_menu";
    $result = mysqli_query($conn, $query);
    $menu = mysqli_fetch_assoc($result);
    
    if ($menu && $menu['stok'] >= $qty) {
        $found = false;
        foreach ($_SESSION['keranjang'] as &$item) {
            if ($item['id_menu'] == $id_menu) {
                $item['qty'] += $qty;
                $found = true;
                break;
            }
        }
        if (!$found) {
            $_SESSION['keranjang'][] = [
                'id_menu' => $id_menu,
                'nama_menu' => $menu['nama_menu'],
                'harga' => $menu['harga'],
                'hpp' => $menu['hpp'],
                'qty' => $qty
            ];
        }
        $pesan = '<div class="alert alert-success">Menu ditambahkan ke keranjang!</div>';
    } else {
        $pesan = '<div class="alert alert-danger">Stok tidak mencukupi!</div>';
    }
}

if (isset($_GET['hapus_keranjang'])) {
    $id_menu = (int)$_GET['hapus_keranjang'];
    foreach ($_SESSION['keranjang'] as $key => $item) {
        if ($item['id_menu'] == $id_menu) {
            unset($_SESSION['keranjang'][$key]);
            $_SESSION['keranjang'] = array_values($_SESSION['keranjang']);
            break;
        }
    }
    header('Location: kasir.php?page=kasir');
    exit;
}

if (isset($_GET['kosongkan'])) {
    $_SESSION['keranjang'] = [];
