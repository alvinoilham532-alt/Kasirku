    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['proses_bayar'])) {
    $bayar = (int)$_POST['bayar'];
    $total = 0;
    foreach ($_SESSION['keranjang'] as $item) {
        $total += $item['harga'] * $item['qty'];
    }
    
    if ($bayar < $total) {
        $pesan = '<div class="alert alert-danger">Uang bayar kurang! Total: ' . formatRupiah($total) . '</div>';
    } else {
        $no_transaksi = generateNoTransaksi($conn);
        $kembalian = $bayar - $total;
        
        $query = "INSERT INTO tb_transaksi (no_transaksi, total_harga, bayar, kembalian) 
                  VALUES ('$no_transaksi', $total, $bayar, $kembalian)";
        mysqli_query($conn, $query);
        $id_transaksi = mysqli_insert_id($conn);
        
        $total_hpp = 0;
        foreach ($_SESSION['keranjang'] as $item) {
            $id_menu = $item['id_menu'];
            $qty = $item['qty'];
            $harga = $item['harga'];
            $hpp = $item['hpp'];
            $subtotal = $harga * $qty;
            $total_hpp += $hpp * $qty;
            
            mysqli_query($conn, "INSERT INTO tb_detail_transaksi 
                (id_transaksi, id_menu, jumlah_beli, harga, total) 
                VALUES ($id_transaksi, $id_menu, $qty, $harga, $subtotal)");
            
            mysqli_query($conn, "UPDATE tb_menu SET stok = stok - $qty WHERE id_menu = $id_menu");
        }
        
        // Simpan ke modal sebagai keuntungan penjualan
        $keuntungan = $total - $total_hpp;
        mysqli_query($conn, "INSERT INTO tb_modal (tanggal, keterangan, jumlah, jenis) 
            VALUES (CURDATE(), 'Keuntungan Penjualan $no_transaksi', $keuntungan, 'modal')");
        
        $_SESSION['keranjang'] = [];
        $pesan = '<div class="alert alert-success">
                    <h5><i class="fa-solid fa-check-circle me-2"></i>Transaksi Berhasil!</h5>
                    <p class="mb-1">No Transaksi: <strong>' . $no_transaksi . '</strong></p>
                    <p class="mb-1">Total: <strong>' . formatRupiah($total) . '</strong></p>
                    <p class="mb-1">Bayar: <strong>' . formatRupiah($bayar) . '</strong></p>
                    <p class="mb-0">Kembalian: <strong>' . formatRupiah($kembalian) . '</strong></p>
                  </div>';
    }
}

